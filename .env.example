# ==============================================================================
# KEINA MARK STUDIO — VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env.local para configurar credenciais reais
# ==============================================================================

# 1. Supabase Cloud (Autenticação, Banco de Dados PostgreSQL e Storage)
# Obtenha estas chaves no painel do Supabase em Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-chave-anonima-publica"
SUPABASE_SERVICE_ROLE_KEY="sua-chave-secreta-service-role"

# 2. Domínio e URL da Aplicação (Configurar na Vercel)
NEXT_PUBLIC_SITE_URL="https://keinamark.com.br"

# 3. Gateway de Frete (Opcional - Ativar quando contratado com a transportadora)
# Deixar em branco enquanto estiver aguardando aprovação comercial
MELHOR_ENVIO_TOKEN=""
FRENET_TOKEN=""

# 4. Gateway de Pagamento (Fase futura - intencionalmente inativo na Fase 1)
# STRIPE_SECRET_KEY=""
# MERCADOPAGO_ACCESS_TOKEN=""
